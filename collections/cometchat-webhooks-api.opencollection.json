{
  "opencollection": "1.0.0",
  "info": {
    "name": "CometChat REST Management Auth Tokens Webhooks API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
