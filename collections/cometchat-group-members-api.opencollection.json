{
  "opencollection": "1.0.0",
  "info": {
    "name": "CometChat REST Management Auth Tokens Group Members API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Group Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List group members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/groups/:guid/members",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path",
                "description": "Unique group identifier (lowercased automatically)."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "scopes",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List group members"
        },
        {
          "info": {
            "name": "Add members to a group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/groups/:guid/members",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path",
                "description": "Unique group identifier (lowercased automatically)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add members to a group"
        },
        {
          "info": {
            "name": "Change a member's scope",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/groups/:guid/members",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path",
                "description": "Unique group identifier (lowercased automatically)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Change a member's scope"
        },
        {
          "info": {
            "name": "Kick a member from a group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/groups/:guid/members/:uid",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path",
                "description": "Unique group identifier (lowercased automatically)."
              },
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ]
          },
          "docs": "Kick a member from a group"
        }
      ]
    }
  ],
  "bundled": true
}