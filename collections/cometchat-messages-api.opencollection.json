{
  "opencollection": "1.0.0",
  "info": {
    "name": "CometChat REST Management Auth Tokens Messages API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/messages",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "searchKey",
                "value": "",
                "type": "query"
              },
              {
                "name": "receiverType",
                "value": "",
                "type": "query"
              },
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "sentAt",
                "value": "",
                "type": "query"
              },
              {
                "name": "affix",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List messages"
        },
        {
          "info": {
            "name": "Send a message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/messages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send a message"
        },
        {
          "info": {
            "name": "Get a message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/messages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Numeric message identifier."
              }
            ]
          },
          "docs": "Get a message"
        },
        {
          "info": {
            "name": "Update a message",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/messages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Numeric message identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a message"
        },
        {
          "info": {
            "name": "Delete a message",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/messages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Numeric message identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a message"
        }
      ]
    }
  ],
  "bundled": true
}