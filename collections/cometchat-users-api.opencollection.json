{
  "opencollection": "1.0.0",
  "info": {
    "name": "CometChat REST Management Auth Tokens Users API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "searchKey",
                "value": "",
                "type": "query",
                "description": "Filter users by UID or name."
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user"
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ]
          },
          "docs": "Get a user"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user"
        },
        {
          "info": {
            "name": "Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a user"
        },
        {
          "info": {
            "name": "Deactivate a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid/deactivate",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ]
          },
          "docs": "Deactivate a user"
        },
        {
          "info": {
            "name": "Reactivate a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid/reactivate",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ]
          },
          "docs": "Reactivate a user"
        }
      ]
    }
  ],
  "bundled": true
}