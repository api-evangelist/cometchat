{
  "opencollection": "1.0.0",
  "info": {
    "name": "CometChat REST Management Auth Tokens Friends API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Friends",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add friends for a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/friends",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add friends for a user"
        },
        {
          "info": {
            "name": "List a user's friends",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid/friends",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ]
          },
          "docs": "List a user's friends"
        },
        {
          "info": {
            "name": "Remove friends for a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{appId}.api-{region}.cometchat.io/v3/users/:uid/friends",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique user identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove friends for a user"
        }
      ]
    }
  ],
  "bundled": true
}